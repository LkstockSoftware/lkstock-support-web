@page "/"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>LkStock Soporte</PageTitle>

@if (!authenticated)
{
    <main class="login-shell">
        <section class="login-card">
            <div class="login-brand"><div class="brand-mark">LK</div><div><p class="eyebrow">LkStock · Atención oficial</p><h1>Centro de soporte</h1></div></div>
            <p class="muted">Acceso privado para el operador autorizado.</p>
            <label for="email">Correo electrónico</label>
            <input id="email" @bind="email" type="email" autocomplete="email" inputmode="email" />
            <label for="password">Contraseña</label>
            <input id="password" @bind="password" type="password" autocomplete="current-password" @onkeydown="LoginKeyDown" />
            <button class="primary login-button" @onclick="Login" disabled="@sending">@(sending ? "Ingresando..." : "Ingresar al panel")</button>
            @if (!string.IsNullOrWhiteSpace(message)) { <p class="notice" role="status">@message</p> }
        </section>
    </main>
}
else
{
    <main class="support-shell">
        <aside class="conversation-panel">
            <header class="panel-header"><div><p class="eyebrow">LkStock Soporte</p><h1>Conversaciones</h1></div><button class="icon-button" title="Actualizar conversaciones" @onclick="LoadConversations">↻</button></header>
            <div class="operator"><span>@operatorEmail</span><div class="operator-actions"><button @onclick="Logout">Salir</button></div></div>
            <div class="search-box"><span>⌕</span><input @bind="search" @bind:event="oninput" @onkeydown="SearchKeyDown" placeholder="Buscar nombre, empresa o ID..." /><button title="Buscar" @onclick="LoadConversations">Buscar</button></div><div class="conversation-list">
                @foreach (var item in conversations)
                {
                    <button class="conversation @(selected?.Id == item.Id ? "selected" : "")" @onclick="() => SelectConversation(item)"><span class="avatar">@Initials(item)</span><span class="conversation-text"><strong>@if (item.Pinned) { <span class="pin-mark" title="Fijado">●</span> } @DisplayName(item)</strong><small>@CompanyLabel(item)</small></span><span class="status-dot @item.Status"></span></button>
                }
                @if (!conversations.Any()) { <p class="empty">No hay conversaciones disponibles.</p> }
            </div>
        </aside>
        <section class="chat-panel">
            @if (selected is null)
            {
                <div class="empty-chat"><div class="brand-mark">LK</div><h2>Seleccioná una conversación</h2><p>El historial y los controles de atención aparecerán aquí.</p></div>
            }
            else
            {
                <header class="chat-header"><div><p class="eyebrow">@CompanyLabel(selected)</p><h2>@DisplayName(selected)</h2><span>+@selected.WaId · Estado: <b>@StatusLabel(selected.Status)</b></span></div><div class="actions"><button @onclick="TogglePin" disabled="@busy">@(selected.Pinned ? "Quitar fijado" : "Fijar arriba")</button><button @onclick="OpenProfileDialog">Editar ficha</button><button @onclick="Takeover" disabled="@(busy || selected.Status == "manual")">Tomar</button><button @onclick="ReturnToBot" disabled="@(busy || selected.Status == "bot")">Devolver al bot</button><button class="danger" @onclick="Close" disabled="@busy">Cerrar</button></div></header>
                <div class="messages">@foreach (var item in messages) { <article class="bubble @item.Direction"><p>@item.Body</p><small>@item.CreatedAt.LocalDateTime.ToString("dd/MM HH:mm") @Delivery(item)</small></article> } @if (!messages.Any()) { <p class="empty">Sin mensajes registrados.</p> }</div>
                <footer class="reply-box"><textarea @bind="replyText" placeholder="Escribí una respuesta para el cliente..." disabled="@busy"></textarea><button class="primary" @onclick="Reply" disabled="@(busy || string.IsNullOrWhiteSpace(replyText))">Enviar</button></footer>
            }
            @if (!string.IsNullOrWhiteSpace(message)) { <div class="toast">@message</div> }
        </section>
    </main>
    @if (showProfileDialog)
    {
        <div class="modal-backdrop" role="presentation"><section class="password-dialog" role="dialog" aria-modal="true" aria-labelledby="profile-title"><button class="dialog-close" title="Cerrar" @onclick="CloseProfileDialog">×</button><p class="eyebrow">Ficha del cliente</p><h2 id="profile-title">Identificar conversación</h2><p class="muted">El nombre de WhatsApp se puede corregir. El ID y la empresa son datos internos de LkStock.</p><label for="contact-name">Nombre del contacto</label><input id="contact-name" @bind="profileDisplayName" /><label for="company-id">ID de empresa LkStock</label><input id="company-id" @bind="profileCompanyId" placeholder="Ej.: 105" /><label for="company-name">Nombre de empresa</label><input id="company-name" @bind="profileCompanyName" placeholder="Ej.: Comercial San Miguel" /><button class="primary dialog-save" @onclick="SaveProfile" disabled="@savingProfile">@(savingProfile ? "Guardando..." : "Guardar ficha")</button>@if (!string.IsNullOrWhiteSpace(profileMessage)) { <p class="notice">@profileMessage</p> }</section></div>
    }
}

@code {
    private readonly JsonSerializerOptions json = new() { PropertyNameCaseInsensitive = true };
    private string? token; private string email = "lkstocksoftware@gmail.com"; private string password = ""; private string operatorEmail = ""; private string message = ""; private string replyText = ""; private string search = ""; private string profileDisplayName = ""; private string profileCompanyId = ""; private string profileCompanyName = ""; private string profileMessage = ""; private bool authenticated; private bool sending; private bool busy; private bool showProfileDialog; private bool savingProfile;
    private List<Conversation> conversations = []; private List<SupportMessage> messages = []; private Conversation? selected;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (!firstRender) return; token = await JS.InvokeAsync<string?>("lkstockAuth.captureFromUrl"); if (!string.IsNullOrWhiteSpace(token)) await LoadSession(); StateHasChanged(); }
    private async Task LoginKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") await Login(); }
    private async Task Login() { sending = true; message = ""; try { var response = await Http.PostAsJsonAsync("api/auth/login", new { email, password }); if (response.IsSuccessStatusCode) { var data = await response.Content.ReadFromJsonAsync<LoginResponse>(json); token = data?.AccessToken; if (!string.IsNullOrWhiteSpace(token)) { await JS.InvokeVoidAsync("lkstockAuth.store", token); password = ""; await LoadSession(); } else message = "No fue posible iniciar sesión."; } else message = "Correo o contraseña incorrectos."; } finally { sending = false; } }
    private async Task SearchKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") await LoadConversations(); }
    private void OpenProfileDialog() { if (selected is null) return; profileDisplayName = selected.DisplayName ?? ""; profileCompanyId = selected.CompanyId ?? ""; profileCompanyName = selected.CompanyName ?? ""; profileMessage = ""; showProfileDialog = true; }
    private void CloseProfileDialog() { showProfileDialog = false; profileMessage = ""; }
    private async Task SaveProfile() { if (selected is null) return; savingProfile = true; profileMessage = ""; try { var response = await Authorized(HttpMethod.Post, "api/actions", new { action = "profile_update", conversationId = selected.Id, displayName = profileDisplayName, companyId = profileCompanyId, companyName = profileCompanyName }); if (response.IsSuccessStatusCode) { showProfileDialog = false; message = "Ficha del cliente guardada."; await LoadConversations(); selected = conversations.FirstOrDefault(x => x.Id == selected.Id); } else profileMessage = "No se pudo guardar la ficha."; } finally { savingProfile = false; } }
    private async Task TogglePin() { if (selected is null) return; var wasPinned = selected.Pinned; busy = true; var response = await Authorized(HttpMethod.Post, "api/actions", new { action = wasPinned ? "unpin" : "pin", conversationId = selected.Id }); message = response.IsSuccessStatusCode ? (wasPinned ? "Conversación quitada de fijados." : "Conversación fijada arriba.") : "No se pudo actualizar el fijado."; busy = false; await LoadConversations(); selected = conversations.FirstOrDefault(x => x.Id == selected.Id); }
    private async Task LoadSession() { var response = await Authorized(HttpMethod.Get, "api/session"); if (!response.IsSuccessStatusCode) { await Logout(); return; } var data = await response.Content.ReadFromJsonAsync<SessionInfo>(json); authenticated = data is not null; operatorEmail = data?.Email ?? ""; if (authenticated) await LoadConversations(); }
    private async Task LoadConversations() { var url = string.IsNullOrWhiteSpace(search) ? "api/conversations" : $"api/conversations?search={Uri.EscapeDataString(search)}"; var response = await Authorized(HttpMethod.Get, url); if (!response.IsSuccessStatusCode) { message = "No se pudieron cargar las conversaciones."; return; } conversations = (await response.Content.ReadFromJsonAsync<ConversationResponse>(json))?.Conversations ?? []; }
    private async Task SelectConversation(Conversation item) { selected = item; replyText = ""; messages = []; var response = await Authorized(HttpMethod.Get, $"api/messages?conversationId={Uri.EscapeDataString(item.Id)}"); messages = (await response.Content.ReadFromJsonAsync<MessageResponse>(json))?.Messages ?? []; }
    private async Task Takeover() => await Action("takeover"); private async Task ReturnToBot() => await Action("return_to_bot"); private async Task Close() => await Action("close");
    private async Task Action(string action) { if (selected is null) return; busy = true; var response = await Authorized(HttpMethod.Post, "api/actions", new { action, conversationId = selected.Id }); message = response.IsSuccessStatusCode ? "Estado actualizado y sincronizado con Notion." : "No se pudo actualizar el caso."; busy = false; await LoadConversations(); selected = conversations.FirstOrDefault(x => x.Id == selected.Id); }
    private async Task Reply() { if (selected is null) return; busy = true; var response = await Authorized(HttpMethod.Post, "api/reply", new { conversationId = selected.Id, text = replyText }); message = response.IsSuccessStatusCode ? "Mensaje enviado desde el número oficial de LkStock." : "No se pudo enviar el mensaje."; if (response.IsSuccessStatusCode) { replyText = ""; await SelectConversation(selected); await LoadConversations(); } busy = false; }
    private async Task<HttpResponseMessage> Authorized(HttpMethod method, string url, object? body = null) { var request = new HttpRequestMessage(method, url); request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token); if (body is not null) request.Content = JsonContent.Create(body); return await Http.SendAsync(request); }
    private async Task Logout() { authenticated = false; token = null; password = ""; conversations = []; messages = []; selected = null; await JS.InvokeVoidAsync("lkstockAuth.clear"); }
    private static string DisplayName(Conversation item) => string.IsNullOrWhiteSpace(item.DisplayName) ? $"+{item.WaId}" : item.DisplayName; private static string Initials(Conversation item) => DisplayName(item)[..1].ToUpperInvariant(); private static string CompanyLabel(Conversation item) => !string.IsNullOrWhiteSpace(item.CompanyName) ? $"{item.CompanyName}{(string.IsNullOrWhiteSpace(item.CompanyId) ? "" : $" · ID {item.CompanyId}")}" : (string.IsNullOrWhiteSpace(item.CompanyId) ? StatusLabel(item.Status) : $"ID {item.CompanyId} · {StatusLabel(item.Status)}"); private static string StatusLabel(string status) => status switch { "manual" => "En atención", "closed" => "Cerrado", _ => "Bot activo" }; private static string Delivery(SupportMessage item) => item.Direction == "outbound" && !string.IsNullOrWhiteSpace(item.DeliveryStatus) ? "· " + item.DeliveryStatus : "";
    private sealed class LoginResponse { public string? AccessToken { get; set; } } private sealed class SessionInfo { public string Email { get; set; } = ""; } private sealed class ConversationResponse { public List<Conversation> Conversations { get; set; } = []; } private sealed class MessageResponse { public List<SupportMessage> Messages { get; set; } = []; } private sealed class Conversation { public string Id { get; set; } = ""; public string WaId { get; set; } = ""; public string? DisplayName { get; set; } public string? CompanyId { get; set; } public string? CompanyName { get; set; } public bool Pinned { get; set; } public string Status { get; set; } = "bot"; } private sealed class SupportMessage { public string Direction { get; set; } = "inbound"; public string? Body { get; set; } public string? DeliveryStatus { get; set; } public DateTimeOffset CreatedAt { get; set; } }
}
