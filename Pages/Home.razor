@page "/"
@using LkStockSupport.Domain.Models
@using LkStockSupport.Infrastructure.Repositories
@inject ISupportRepository Repository
@inject IJSRuntime JS

<PageTitle>LkStock Soporte</PageTitle>

@if (!authenticated)
{
    <main class="login-shell">
        <section class="login-card">
            <div class="login-brand"><div class="brand-mark">LK</div><div><p class="eyebrow">LkStock · Atención oficial</p><h1>Centro de soporte</h1></div></div>
            <p class="muted">Acceso privado para el operador autorizado.</p>
            <small class="app-version">@versionLabel</small>
            <label for="email">Correo electrónico</label>
            <input id="email" @bind="email" type="email" autocomplete="email" inputmode="email" />
            <label for="password">Contraseña</label>
            <input id="password" @bind="password" type="password" autocomplete="current-password" @onkeydown="LoginKeyDown" />
            <button class="primary login-button" @onclick="Login" disabled="@sending">@if (sending) { <span class="button-spinner"></span> } @(sending ? "Ingresando..." : "Ingresar al panel")</button>
        </section>
    </main>
}
else
{
    <main class="support-shell @(selected is null ? "no-selection" : "conversation-selected")">
        <aside class="conversation-panel">
            <header class="panel-header"><div><p class="eyebrow">LkStock Soporte</p><h1>Conversaciones</h1></div><button class="icon-button" title="Actualizar conversaciones" @onclick="LoadConversations" disabled="@conversationsLoading">@if (conversationsLoading) { <span class="button-spinner"></span> } else { <span>↻</span> }</button></header>
            <div class="operator"><span>@operatorEmail</span><div class="operator-actions"><button @onclick="Logout">Salir</button></div></div>
            <div class="search-box"><span>⌕</span><input @bind="search" @bind:event="oninput" @onkeydown="SearchKeyDown" placeholder="Buscar nombre, empresa o ID..." /><button title="Buscar" @onclick="LoadConversations" disabled="@conversationsLoading">Buscar</button></div>
            <div class="conversation-list">
                @if (conversationsLoading) { <div class="list-activity"><span class="spinner"></span><span>Actualizando conversaciones...</span></div> }
                @foreach (var item in conversations)
                {
                    <button class="conversation @(selected?.Id == item.Id ? "selected" : "")" @onclick="() => SelectConversation(item)" disabled="@busy"><span class="avatar">@Initials(item)</span><span class="conversation-text"><strong>@if (item.Pinned) { <span class="pin-mark" title="Fijado">●</span> } @DisplayName(item)</strong><small>@CompanyLabel(item)</small></span><span class="status-dot @item.Status"></span></button>
                }
                @if (!conversationsLoading && !conversations.Any()) { <p class="empty">No hay conversaciones disponibles.</p> }
            </div>
        </aside>
        <section class="chat-panel">
            @if (selected is null)
            {
                <div class="empty-chat"><div class="brand-mark">LK</div><h2>Seleccioná una conversación</h2><p>El historial y los controles de atención aparecerán aquí.</p></div>
            }
            else
            {
                <header class="chat-header"><div><p class="eyebrow">@CompanyLabel(selected)</p><h2>@DisplayName(selected)</h2><span>+@selected.WaId · Estado: <b>@StatusLabel(selected.Status)</b> · @versionLabel</span></div><div class="actions"><button @onclick="TogglePin" disabled="@busy">@(selected.Pinned ? "Quitar fijado" : "Fijar arriba")</button><button @onclick="OpenProfileDialog" disabled="@busy">Editar ficha</button><button @onclick="Takeover" disabled="@(busy || selected.Status == "manual")">Tomar</button><button @onclick="ReturnToBot" disabled="@(busy || selected.Status == "bot")">Devolver al bot</button><button class="danger" @onclick="Close" disabled="@busy">Cerrar</button></div></header>
                <div class="messages">
                    @if (loadingMessages) { <div class="message-activity"><span class="spinner"></span><span>Cargando historial...</span></div> }
                    else
                    {
                        @foreach (var item in messages) { <article class="bubble @item.Direction"><p>@item.Body</p><small>@item.CreatedAt.LocalDateTime.ToString("dd/MM HH:mm") @Delivery(item)</small></article> }
                        @if (!messages.Any()) { <p class="empty">Sin mensajes registrados.</p> }
                    }
                </div>
                <footer class="reply-box"><textarea @bind="replyText" @bind:event="oninput" placeholder="Escribí una respuesta para el cliente..." disabled="@busy"></textarea><button class="primary" @onclick="Reply" disabled="@(busy || string.IsNullOrWhiteSpace(replyText))">@if (busy && busyText.StartsWith("Enviando")) { <span class="button-spinner"></span> } Enviar</button></footer>
            }
        </section>
    </main>
    @if (showProfileDialog)
    {
        <div class="modal-backdrop" role="presentation"><section class="password-dialog" role="dialog" aria-modal="true" aria-labelledby="profile-title"><button class="dialog-close" title="Cerrar" @onclick="CloseProfileDialog" disabled="@savingProfile">×</button><p class="eyebrow">Ficha del cliente</p><h2 id="profile-title">Identificar conversación</h2><p class="muted">El nombre de WhatsApp se puede corregir. El ID y la empresa son datos internos de LkStock.</p><label for="contact-name">Nombre del contacto</label><input id="contact-name" @bind="profileDisplayName" /><label for="company-id">ID de empresa LkStock</label><input id="company-id" @bind="profileCompanyId" placeholder="Ej.: 105" /><label for="company-name">Nombre de empresa</label><input id="company-name" @bind="profileCompanyName" placeholder="Ej.: Comercial San Miguel" /><button class="primary dialog-save" @onclick="SaveProfile" disabled="@savingProfile">@if (savingProfile) { <span class="button-spinner"></span> } @(savingProfile ? "Guardando..." : "Guardar ficha")</button></section></div>
    }
    @if (busy && !string.IsNullOrWhiteSpace(busyText))
    {
        <div class="working-overlay" role="status" aria-live="polite"><div class="working-card"><span class="spinner"></span><strong>@busyText</strong><small>Por favor, esperá un momento.</small></div></div>
    }
}

@code {
    private string? token; private string email = "lkstocksoftware@gmail.com"; private string password = ""; private string operatorEmail = ""; private string replyText = ""; private string search = ""; private string profileDisplayName = ""; private string profileCompanyId = ""; private string profileCompanyName = ""; private string busyText = ""; private string versionLabel = "Versión verificando...";
    private bool authenticated; private bool sending; private bool busy; private bool showProfileDialog; private bool savingProfile; private bool conversationsLoading; private bool loadingMessages;
    private List<Conversation> conversations = []; private List<SupportMessage> messages = []; private Conversation? selected;

    protected override async Task OnAfterRenderAsync(bool firstRender) { if (!firstRender) return; var build = await JS.InvokeAsync<BuildInfo?>("lkstockUi.getBuildInfo"); versionLabel = build is null ? "Versión no disponible" : $"v{build.Version} · {build.Commit}"; token = await JS.InvokeAsync<string?>("lkstockAuth.captureFromUrl"); if (!string.IsNullOrWhiteSpace(token)) await LoadSession(); StateHasChanged(); }
    private async Task LoginKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") await Login(); }
    private async Task Login() { sending = true; try { var data = await Repository.LoginAsync(email, password); token = data?.AccessToken; if (!string.IsNullOrWhiteSpace(token)) { await JS.InvokeVoidAsync("lkstockAuth.store", token); password = ""; await LoadSession(); } else await Error("No se pudo ingresar", "Revisá el correo y la contraseña."); } catch { await Error("No se pudo ingresar", "Verificá tu conexión e intentá de nuevo."); } finally { sending = false; } }
    private async Task SearchKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") await LoadConversations(); }
    private void OpenProfileDialog() { if (selected is null) return; profileDisplayName = selected.DisplayName ?? ""; profileCompanyId = selected.CompanyId ?? ""; profileCompanyName = selected.CompanyName ?? ""; showProfileDialog = true; }
    private void CloseProfileDialog() { showProfileDialog = false; }
    private async Task SaveProfile() { if (selected is null || string.IsNullOrWhiteSpace(token)) return; savingProfile = true; try { var saved = await Repository.UpdateProfileAsync(token, selected.Id, new ProfileUpdateRequest(profileDisplayName, profileCompanyId, profileCompanyName)); if (saved) { showProfileDialog = false; await LoadConversations(); selected = conversations.FirstOrDefault(x => x.Id == selected.Id); await Success("Ficha guardada", "Los datos del cliente fueron actualizados."); } else await Error("No se pudo guardar", "La ficha no pudo actualizarse. Intentá nuevamente."); } finally { savingProfile = false; } }
    private async Task TogglePin() { if (selected is null || string.IsNullOrWhiteSpace(token)) return; var wasPinned = selected.Pinned; await RunBusy(wasPinned ? "Quitando de fijados..." : "Fijando conversación...", async () => { if (!await Repository.SetPinnedAsync(token, selected.Id, !wasPinned)) { await Error("No se pudo actualizar", "La conversación no pudo modificarse."); return; } await LoadConversations(); selected = conversations.FirstOrDefault(x => x.Id == selected.Id); await Success(wasPinned ? "Fijado eliminado" : "Conversación fijada", wasPinned ? "La conversación volvió a su posición normal." : "La conversación aparecerá arriba de la lista."); }); }
    private async Task LoadSession() { if (string.IsNullOrWhiteSpace(token)) { await Logout(); return; } var data = await Repository.GetSessionAsync(token); if (data is null) { await Logout(); return; } authenticated = true; operatorEmail = data.Email; await LoadConversations(); }
    private async Task LoadConversations() { if (string.IsNullOrWhiteSpace(token)) return; conversationsLoading = true; try { conversations = (await Repository.GetConversationsAsync(token, search)).ToList(); } catch { await Error("No se pudieron cargar", "Verificá tu conexión e intentá nuevamente."); } finally { conversationsLoading = false; } }
    private async Task SelectConversation(Conversation item) { if (string.IsNullOrWhiteSpace(token)) return; selected = item; replyText = ""; messages = []; loadingMessages = true; try { messages = (await Repository.GetMessagesAsync(token, item.Id)).ToList(); } catch { await Error("No se pudo abrir", "No fue posible cargar el historial de mensajes."); } finally { loadingMessages = false; } }
    private async Task Takeover() { if (await Confirm("¿Tomar esta conversación?", "El bot dejará de responder hasta que devuelvas el caso al bot.", "Sí, tomar caso")) await Action("takeover", "Tomando conversación..."); }
    private async Task ReturnToBot() { if (await Confirm("¿Devolver al bot?", "La IA volverá a responder los mensajes nuevos de este cliente.", "Sí, devolver al bot")) await Action("return_to_bot", "Devolviendo al bot..."); }
    private async Task Close() { if (await Confirm("¿Cerrar este caso?", "Podrás reabrirlo cuando el cliente escriba nuevamente.", "Sí, cerrar caso")) await Action("close", "Cerrando caso..."); }
    private async Task Action(string action, string activity) { if (selected is null || string.IsNullOrWhiteSpace(token)) return; await RunBusy(activity, async () => { var changed = action switch { "takeover" => await Repository.TakeoverAsync(token, selected.Id), "return_to_bot" => await Repository.ReturnToBotAsync(token, selected.Id), "close" => await Repository.CloseAsync(token, selected.Id), _ => false }; if (!changed) { await Error("No se pudo actualizar", "El estado del caso no pudo modificarse."); return; } await LoadConversations(); selected = conversations.FirstOrDefault(x => x.Id == selected.Id); await Success("Caso actualizado", "El cambio fue sincronizado con Notion."); }); }
    private async Task Reply() { if (selected is null || string.IsNullOrWhiteSpace(token)) return; await RunBusy("Enviando mensaje...", async () => { if (!await Repository.SendReplyAsync(token, selected.Id, replyText)) { await Error("No se pudo enviar", "El mensaje no salió. Intentá nuevamente."); return; } replyText = ""; await SelectConversation(selected); await LoadConversations(); await Success("Mensaje enviado", "El mensaje fue enviado desde el número oficial de LkStock."); }); }
    private async Task RunBusy(string activity, Func<Task> work) { busy = true; busyText = activity; try { await work(); } catch { await Error("Ocurrió un problema", "No fue posible completar la acción. Intentá nuevamente."); } finally { busy = false; busyText = ""; } }
    private async Task Success(string title, string text) => await JS.InvokeVoidAsync("lkstockUi.success", title, text);
    private async Task Error(string title, string text) => await JS.InvokeVoidAsync("lkstockUi.error", title, text);
    private async Task<bool> Confirm(string title, string text, string confirmText) => await JS.InvokeAsync<bool>("lkstockUi.confirm", title, text, confirmText);
    private async Task Logout() { authenticated = false; token = null; password = ""; conversations = []; messages = []; selected = null; await JS.InvokeVoidAsync("lkstockAuth.clear"); }
    private static string DisplayName(Conversation item) => string.IsNullOrWhiteSpace(item.DisplayName) ? $"+{item.WaId}" : item.DisplayName;
    private static string Initials(Conversation item) => DisplayName(item)[..1].ToUpperInvariant();
    private static string CompanyLabel(Conversation item) => !string.IsNullOrWhiteSpace(item.CompanyName) ? $"{item.CompanyName}{(string.IsNullOrWhiteSpace(item.CompanyId) ? "" : $" · ID {item.CompanyId}")}" : (string.IsNullOrWhiteSpace(item.CompanyId) ? StatusLabel(item.Status) : $"ID {item.CompanyId} · {StatusLabel(item.Status)}");
    private static string StatusLabel(string status) => status switch { "manual" => "En atención", "closed" => "Cerrado", _ => "Bot activo" };
    private sealed class BuildInfo { public string Version { get; set; } = "?"; public string Commit { get; set; } = "?"; }
    private static string Delivery(SupportMessage item) => item.Direction == "outbound" && !string.IsNullOrWhiteSpace(item.DeliveryStatus) ? "· " + item.DeliveryStatus : "";
}